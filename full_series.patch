+	jbcptr->ptr = *toast_ptr;
+	jbcptr->tail_size = tail_size;
+	jbcptr->tail_data = tail_data;
+	jbcptr->ntids = ntids;
+	jbcptr->compressed_tids = compressed_tids;
+	jbcptr->compressed_chunks = compressed_chunks;
