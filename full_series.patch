+		ocursor->size = icursor->size;
+		ocursor->unique_keys = icursor->unique_keys;
+		ocursor->skip_nulls = icursor->skip_nulls;
+		pocursor = &ocursor->next;
+	}
+
+	*pocursor = NULL;
+
+	return result;
