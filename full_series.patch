+	res = executeJsonPathUpdate(jp, vars, EvalJsonPathVar,
+								jb_oldval, val_isnull ? NULL : &jbv_newval,
+								op, onExisting, onMissing, onNull,
+								false, false);
+
+	if (!res)
+		return (Datum) 0;
+
+	return JsonValueToJsonbDatum(res);
