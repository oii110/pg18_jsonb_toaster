 1 file changed, 51 insertions(+), 1 deletion(-)

diff --git a/contrib/jsonb_toaster/jsonb_toaster.c b/contrib/jsonb_toaster/jsonb_toaster.c
index d7a0954074..2a34808f7f 100644
--- a/contrib/jsonb_toaster/jsonb_toaster.c
