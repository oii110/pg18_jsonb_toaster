+		const char *need = detoast_iter->buf->buf + offset + length;
+
+		Assert(need <= detoast_iter->buf->capacity);
+
+		while (!detoast_iter->done && need > detoast_iter->buf->limit)
+			jsonx_detoast_iterate(detoast_iter, need);
