+	Assert(VARATT_IS_CUSTOM(value));
+
+	header = JSONX_CUSTOM_PTR_GET_HEADER(value);
+	Assert((header & JSONX_POINTER_TYPE_MASK) == JSONX_CHUCKED_ARRAY);
