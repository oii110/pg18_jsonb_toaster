+	result = palloc(VARATT_CUSTOM_GET_DATA_RAW_SIZE(attr));
+	SET_VARSIZE(result, VARATT_CUSTOM_GET_DATA_RAW_SIZE(attr));
+	memcpy(VARDATA(result), VARATT_CUSTOM_GET_DATA(attr),
