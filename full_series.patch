 jsonvContainerOps =
 {
@@ -559,6 +643,7 @@ jsonvContainerOps =
 	jsonvGetArrayElement,
 	jsonvGetArraySize,
 	JsonbToCStringRaw,
+	jsonvCopy,
 };
 
 JsonValue *
@@ -679,6 +764,18 @@ JsonValueToJson(JsonValue *val)
 	}
 }
 
